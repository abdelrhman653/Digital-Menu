rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ================================
       AUTH / OWNER
       ================================ */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "9XrMCexywXh72WPvo756PcuVuhD3";
    }


    /* ================================
       RESTAURANT HELPERS
       ================================ */

    function restaurantExists(restaurantId) {
      return exists(
        /databases/$(database)/documents/restaurants/$(restaurantId)
      );
    }

    function activeRestaurant(restaurantId) {
      return restaurantExists(restaurantId)
        && get(
          /databases/$(database)/documents/restaurants/$(restaurantId)
        ).data.licenseStatus == 'active'
        && (
          get(
            /databases/$(database)/documents/restaurants/$(restaurantId)
          ).data.plan == 'lifetime'
          ||
          (
            get(
              /databases/$(database)/documents/restaurants/$(restaurantId)
            ).data.licenseExpiresAt is timestamp
            &&
            get(
              /databases/$(database)/documents/restaurants/$(restaurantId)
            ).data.licenseExpiresAt > request.time
          )
        );
    }

    function ownerOfRestaurant(restaurantId) {
      return signedIn()
        && restaurantExists(restaurantId)
        && get(
          /databases/$(database)/documents/restaurants/$(restaurantId)
        ).data.ownerUid == request.auth.uid;
    }

    function activeOwnerOfRestaurant(restaurantId) {
      return ownerOfRestaurant(restaurantId)
        && activeRestaurant(restaurantId);
    }


    /* ================================
       LICENSES
       ================================ */

    match /licenses/{code} {

      /* أي مستخدم مسجل يستطيع قراءة كود محدد */
      allow get: if true;

      /* المالك يستطيع عرض قائمة الأكواد */
      allow list: if isOwner();

      /* إنشاء كود اشتراك */
      allow create: if isOwner()
        && request.resource.data.code is string
        && request.resource.data.restaurantId is string
        && request.resource.data.plan is string
        && request.resource.data.status == 'available'
        && request.resource.data.used == false
        && request.resource.data.createdBy == request.auth.uid;

      /* استخدام الكود مرة واحدة أو تعديل المالك */
      allow update: if isOwner()
        ||
        (
          signedIn()
          && resource.data.status == 'available'
          && resource.data.used == false
          && request.resource.data.status == 'used'
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.restaurantId is string
        );

      /* المالك فقط يحذف كود */
      allow delete: if isOwner();
    }


    /* ================================
       OWNER PROFILES
       ================================ */

    match /ownerProfiles/{uid} {

      allow read: if signedIn()
        && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.restaurantId
          == resource.data.restaurantId;

      allow delete: if false;
    }


    /* ================================
       RESTAURANTS
       ================================ */

    match /restaurants/{restaurantId} {

      /* بيانات المطعم متاحة للقراءة */
      allow read: if true;

      /*
       * إنشاء مطعم باستخدام كود صالح
       */
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.licenseStatus == 'active'
        && request.resource.data.licenseCode is string

        && exists(
          /databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)
        )

        && getAfter(
          /databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)
        ).data.usedBy == request.auth.uid

        && getAfter(
          /databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)
        ).data.restaurantId == restaurantId;


      /*
       * تحديث المطعم
       *
       * OWNER:
       * يستطيع تعديل إعدادات المطاعم وإعدادات النظام.
       *
       * RESTAURANT OWNER:
       * يستطيع تعديل البيانات العادية فقط،
       * ولا يستطيع تغيير الترخيص.
       */
      allow update: if isOwner()
        ||
        (
          activeOwnerOfRestaurant(restaurantId)

          && request.resource.data.ownerUid
            == resource.data.ownerUid

          && request.resource.data.licenseCode
            == resource.data.licenseCode

          && request.resource.data.licenseExpiresAt
            == resource.data.licenseExpiresAt

          && request.resource.data.licenseStatus
            == resource.data.licenseStatus

          && request.resource.data.plan
            == resource.data.plan
        );

      allow delete: if false;
    }


    /* ================================
       ORDERS
       ================================ */

    match /orders/{orderId} {

      /* إنشاء طلب */
      allow create: if request.resource.data.restaurant is string
        && activeRestaurant(
          request.resource.data.restaurant
        );

      /* قراءة الطلبات */
      allow read: if resource.data.restaurant is string
        && activeRestaurant(
          resource.data.restaurant
        );

      /* تعديل الطلبات */
      allow update: if resource.data.restaurant is string
        && activeOwnerOfRestaurant(
          resource.data.restaurant
        );

      allow delete: if false;
    }


    /* ================================
       DEFAULT DENY
       ================================ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

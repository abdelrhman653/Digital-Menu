rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "9XrMCexywXh72WPvo756PcuVuhD3";
    }

    function restaurantExists(restaurantId) {
      return exists(
        /databases/$(database)/documents/restaurants/$(restaurantId)
      );
    }

    function restaurantLicenseCode(restaurantId) {
      return get(
        /databases/$(database)/documents/restaurants/$(restaurantId)
      ).data.licenseCode;
    }

    function linkedLicenseExists(restaurantId) {
      return restaurantLicenseCode(restaurantId) is string
        && exists(
          /databases/$(database)/documents/licenses/$(restaurantLicenseCode(restaurantId))
        );
    }

    function linkedLicenseActive(restaurantId) {
      return linkedLicenseExists(restaurantId)
        && get(
          /databases/$(database)/documents/licenses/$(restaurantLicenseCode(restaurantId))
        ).data.status == 'used'
        && get(
          /databases/$(database)/documents/licenses/$(restaurantLicenseCode(restaurantId))
        ).data.used == true
        && (
          get(
            /databases/$(database)/documents/licenses/$(restaurantLicenseCode(restaurantId))
          ).data.plan == 'lifetime'
          || (
            get(
              /databases/$(database)/documents/licenses/$(restaurantLicenseCode(restaurantId))
            ).data.expiresAt is timestamp
            && get(
              /databases/$(database)/documents/licenses/$(restaurantLicenseCode(restaurantId))
            ).data.expiresAt > request.time
          )
        );
    }

    function activeRestaurant(restaurantId) {
      return restaurantExists(restaurantId)
        && get(
          /databases/$(database)/documents/restaurants/$(restaurantId)
        ).data.licenseStatus == 'active'
        && (
          get(
            /databases/$(database)/documents/restaurants/$(restaurantId)
          ).data.plan == 'lifetime'
          || (
            get(
              /databases/$(database)/documents/restaurants/$(restaurantId)
            ).data.licenseExpiresAt is timestamp
            && get(
              /databases/$(database)/documents/restaurants/$(restaurantId)
            ).data.licenseExpiresAt > request.time
          )
          || linkedLicenseActive(restaurantId)
        );
    }

    function ownerOfRestaurant(restaurantId) {
      return signedIn()
        && restaurantExists(restaurantId)
        && get(
          /databases/$(database)/documents/restaurants/$(restaurantId)
        ).data.ownerUid == request.auth.uid;
    }

    function activeOwnerOfRestaurant(restaurantId) {
      return ownerOfRestaurant(restaurantId)
        && activeRestaurant(restaurantId);
    }

    /* ================================
       PLATFORM PLAN PRICES
       ================================ */
    match /platformSettings/planPricing {
      // The public subscription selector needs to read the prices.
      allow read: if true;
      // Only the platform owner can change the displayed plan prices.
      allow write: if isOwner();
    }

    /* ================================
       SUBSCRIPTION PLANS
       ================================ */
    match /platformSettings/subscriptionPlans {
      // Customers only need to read the plans you publish.
      allow read: if true;
      // Only the platform owner can create, edit, or delete plans.
      allow write: if isOwner();
    }

    /* ================================
       LICENSES
       ================================ */
    match /licenses/{code} {
      // Public code lookup is required during restaurant registration.
      // Only the platform owner can list all licenses.
      allow get: if true;
      allow list: if isOwner();

      allow create: if isOwner()
        && request.resource.data.code is string
        && request.resource.data.restaurantId is string
        && request.resource.data.plan is string
        && request.resource.data.status == 'available'
        && request.resource.data.used == false
        && request.resource.data.createdBy == request.auth.uid;

      // Owner can manage licenses; a signed-in restaurant account can consume
      // an available code once. The registration transaction separately binds
      // the code to the new restaurant through getAfter().
      allow update: if isOwner()
        || (
          signedIn()
          && resource.data.status == 'available'
          && resource.data.used == false
          && request.resource.data.status == 'used'
          && request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.restaurantId is string
        );

      allow delete: if isOwner();
    }

    /* ================================
       OWNER PROFILES
       ================================ */
    match /ownerProfiles/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.restaurantId == resource.data.restaurantId;

      allow delete: if false;
    }

    /* ================================
       RESTAURANTS
       ================================ */
    match /restaurants/{restaurantId} {
      // The public menu needs the restaurant document.
      allow read: if true;

      // Registration is performed in one batch: the license update and the
      // restaurant creation are validated together with getAfter().
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.ownerUid
        && request.resource.data.licenseStatus == 'active'
        && request.resource.data.licenseCode is string
        && exists(
          /databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)
        )
        && getAfter(
          /databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)
        ).data.usedBy == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/licenses/$(request.resource.data.licenseCode)
        ).data.restaurantId == restaurantId;

      // Platform owner can manage subscriptions.
      // Restaurant owners can edit menu/branding data but cannot change the
      // owner UID or license code. The plan/expiry are immutable once present.
      // For older restaurants, the owner may populate missing plan/expiry only
      // with the exact values stored in the linked license.
      allow update: if isOwner()
        || (
          ownerOfRestaurant(restaurantId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.licenseCode == resource.data.licenseCode
          && request.resource.data.licenseStatus == resource.data.licenseStatus
          && (
            !resource.data.keys().hasAll(['plan'])
            || request.resource.data.plan == resource.data.plan
          )
          && (
            !resource.data.keys().hasAll(['licenseExpiresAt'])
            || request.resource.data.licenseExpiresAt == resource.data.licenseExpiresAt
          )
        );

      allow delete: if false;
    }

    /* ================================
       ORDERS
       ================================ */
    match /orders/{orderId} {
      // Customers can place orders without an account, but only for an active
      // restaurant. This keeps the public menu usable without Firebase Storage
      // or paid customer authentication.
      allow create: if request.resource.data.restaurant is string
        && activeRestaurant(request.resource.data.restaurant);

      // Public order tracking/history is intentionally supported by the web
      // customer page. The query is still limited client-side to the restaurant
      // and customer phone number.
      allow read: if resource.data.restaurant is string
        && activeRestaurant(resource.data.restaurant);

      allow update: if resource.data.restaurant is string
        && activeOwnerOfRestaurant(resource.data.restaurant);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
